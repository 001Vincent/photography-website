# ─────────────────────────────────────────────────────────────────────────────
#  PRINCE WILLIAMS PHOTOGRAPHY — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (auto-populated by Railway PostgreSQL add-on) ────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ── Google Drive (Service Account) ───────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable Google Drive API
# 3. IAM & Admin → Service Accounts → Create Service Account
# 4. Keys → Add Key → JSON → Download
# 5. Open the JSON file and paste its ENTIRE contents as a single line below
#    (replace all newlines with \n inside the JSON string)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"prince-williams@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# 6. In Google Drive, create a folder called "Prince Williams Photos"
# 7. Right-click the folder → Share → paste the service account client_email above → Editor
# 8. Copy the folder ID from the URL (the long string after /folders/)
GOOGLE_DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_YOUR_DRIVE_FOLDER_ID

# ── Paystack ─────────────────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Using Gmail: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Create an App Password (select "Mail" + "Other") and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=REPLACE_WITH_16_CHAR_APP_PASSWORD
EMAIL_FROM=Prince Williams Photography <your-gmail@gmail.com>

# ── Admin Default Credentials (seeded on first boot) ─────────────────────────
ADMIN_EMAIL=admin@princewilliams.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SITE_NAME=Prince Williams Photography
CONTACT_EMAIL=hello@princewilliams.com
